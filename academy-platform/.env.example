# نموذج متغيرات البيئة — لا تضع أسرارًا حقيقية هنا
DATABASE_URL=postgres://academy:change_me@localhost:5432/academy
JWT_ACCESS_SECRET=change_me_long_random
REFRESH_TOKEN_PEPPER=change_me_long_random
CODE_HMAC_SECRET=change_me_long_random
ACCESS_TOKEN_TTL_SECONDS=900
# قاعدة اختبار منفصلة، يجب أن ينتهي اسمها بـ _test (تُمسح بالكامل عند الاختبار)
TEST_DATABASE_URL=postgres://academy:change_me@localhost:5432/academy_test
PORT=3000
TRUST_PROXY=false
# للتطوير فقط: يعيد رمز استعادة كلمة المرور في الاستجابة. اتركه false في الإنتاج
DEV_EXPOSE_RESET_TOKEN=false
THROTTLE_LIMIT=120
LOGIN_THROTTLE_LIMIT=10
REFRESH_TOKEN_TTL_DAYS=30

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=academy-private
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
SIGNED_URL_TTL_SECONDS=300

FCM_SERVICE_ACCOUNT_JSON_PATH=./secrets/fcm.json
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
